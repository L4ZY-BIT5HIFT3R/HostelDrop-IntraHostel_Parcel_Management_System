# Copy to backend/.env and fill with real values. Do not commit backend/.env.
APP_ENV=development
MONGO_URL=mongodb://localhost:27017
DB_NAME=hosteldrop
JWT_SECRET_KEY=replace_with_a_strong_random_secret
ADMIN_EMAIL=admin@hostel.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
CORS_ORIGINS=http://localhost:19006,http://localhost:8081
ENABLE_SENSITIVE_LOGGING=false
INCLUDE_DEBUG_OTP_IN_RESPONSE=false
TRUST_PROXY_HEADERS=false
ENFORCE_STUDENT_EMAIL_DOMAIN=true
STUDENT_EMAIL_DOMAIN=iiitg.ac.in
SMTP_EMAIL=
SMTP_APP_PASSWORD=
AUTO_DELETE_DELIVERED_INTERVAL_SECONDS=604800
AUTO_DELETE_DELIVERED_POLL_SECONDS=1
QR_PICKUP_TOKEN_TTL_SECONDS=300
MAX_REQUEST_BODY_BYTES=32768
MAX_QUERY_STRING_BYTES=2048
MIN_PASSWORD_LENGTH=8
MIN_JWT_SECRET_LENGTH=32

# Script-only variables (used by helper scripts)
SEED_GUARD_PASSWORD=
BOYS_GUARD_USERNAME=boys_guard
BOYS_GUARD_PASSWORD=
GIRLS_GUARD_USERNAME=girls_guard
GIRLS_GUARD_PASSWORD=
API_BASE_URL=http://localhost:8001/api
TEST_GUARD_USERNAME=boys_guard
TEST_GUARD_PASSWORD=
TEST_GUARD_HOSTEL=BOYS
TEST_STUDENT_PASSWORD=
TEST_STUDENT_WRONG_PASSWORD=
